# 依赖
node_modules/

# 数据库与运行时数据（含 JWT 持久化密钥）
data/*.sqlite*
data/*.backup*
data/.jwt_secret

# 队标/赛事 logo 代理磁盘缓存（可随时删除重建）
data/logo-cache/

# 环境变量（含 API Token / 密钥，切勿提交）
.env
.env.local
.env.*.local

# 临时 / 调试脚本
tmp_*.js
.tmp-*
test/.tmp-*
test/.*.tmp.*
shot-*.png
*.commit-msg.tmp.txt

# 设计素材源文件（woff2 子集已放 public/fonts，TTF 源与 logo 素材不进库）
misans_ttf/
tournament_logo/
public/images/brand-concept.jpg

# 抓取的参考页面（非项目代码）
CS Asia Championships*.html
CS Asia Championships*_files/

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# 操作系统
.DS_Store
Thumbs.db
Desktop.ini

# 编辑器 / IDE 元数据
.agents/
.vscode/
.idea/
*.swp
